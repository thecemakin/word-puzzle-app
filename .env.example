# Application
APP_NAME=Word Puzzle API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (OrbStack PostgreSQL)
POSTGRES_USER=wordpuzzle
POSTGRES_PASSWORD=wordpuzzle_dev
POSTGRES_DB=wordpuzzle
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Security (change in production!)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Game Defaults
DEFAULT_UI_LANGUAGE=tr
ALLOWED_GAME_LANGUAGES=tr,en
ALLOWED_TURN_DURATION_HOURS=12,24,48,72
TIMEOUT_CHECK_INTERVAL_SECONDS=60
